{
  "entities": {
    "Resource": {
      "title": "Resource",
      "description": "A downloadable resource for the community.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the resource."
        },
        "imageUrl": {
          "type": "string",
          "description": "The URL of the resource image."
        },
        "category": {
          "type": "string",
          "description": "Category of the resource."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the resource was added."
        }
      },
      "required": ["name", "imageUrl"]
    },
    "PlayerLookingForTeam": {
      "title": "Player Looking for Team",
      "description": "A player looking to form or join a line.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name or Nickname",
          "maxLength": 100,
          "minLength": 1
        },
        "role": {
          "type": "string",
          "description": "Role (e.g., RUSH, SUPORTE)",
          "maxLength": 50,
          "minLength": 1
        },
        "age": {
          "type": "number",
          "description": "Age"
        },
        "availability": {
          "type": "string",
          "description": "Time availability",
          "maxLength": 200,
          "minLength": 1
        },
        "photoUrl": {
          "type": "string",
          "description": "Photo URL or Base64 avatar"
        },
        "instagram": {
          "type": "string",
          "description": "Instagram handle or link",
          "maxLength": 200
        },
        "achievements": {
          "type": "string",
          "description": "Achievements and titles",
          "maxLength": 1000
        },
        "teamsHistory": {
          "type": "string",
          "description": "Teams history",
          "maxLength": 1000
        },
        "tournamentsHistory": {
          "type": "string",
          "description": "Tournaments played",
          "maxLength": 1000
        },
        "highlightsUrl": {
          "type": "string",
          "description": "Portfolio, YouTube, or Highlights link",
          "maxLength": 500
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the creator"
        }
      },
      "required": ["name", "role", "age", "availability", "createdAt", "userId"]
    }
  },
  "firestore": {
    "lft_players": {
      "schema": "PlayerLookingForTeam",
      "description": "Players looking for a team/line."
    },
    "resources": {
      "schema": "Resource",
      "description": "Collection of community resources."
    },
    "teamLogos": {
      "schema": "Resource",
      "description": "Collection of team logos."
    }
  }
}
