rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jhanmedeiros@gmail.com' && request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResource(data) {
      return data.keys().hasAll(['name', 'imageUrl']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() < 1000;
    }

    function isValidPlayerLookingForTeam(data) {
      return data.keys().hasAll(['name', 'role', 'age', 'availability', 'createdAt', 'userId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 50 &&
             data.age is number &&
             data.availability is string && data.availability.size() > 0 && data.availability.size() <= 200 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000000)) &&
             (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 200)) &&
             (!('achievements' in data) || (data.achievements is string && data.achievements.size() <= 1000)) &&
             (!('teamsHistory' in data) || (data.teamsHistory is string && data.teamsHistory.size() <= 1000)) &&
             (!('tournamentsHistory' in data) || (data.tournamentsHistory is string && data.tournamentsHistory.size() <= 1000)) &&
             (!('highlightsUrl' in data) || (data.highlightsUrl is string && data.highlightsUrl.size() <= 500)) &&
             data.createdAt is number &&
             data.userId is string && data.userId == request.auth.uid;
    }

    // LFT Players Collection
    match /lft_players/{playerId} {
      allow read: if true; // Public read
      allow create: if isSignedIn() && isValidPlayerLookingForTeam(request.resource.data) && isValidId(playerId);
      allow update: if isSignedIn() && isValidPlayerLookingForTeam(request.resource.data) && 
                    (request.resource.data.userId == resource.data.userId) &&
                    (resource.data.userId == request.auth.uid) &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'age', 'availability', 'photoUrl', 'instagram', 'highlightsUrl', 'achievements', 'teamsHistory', 'tournamentsHistory', 'updatedAt']));
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Resources Collection
    match /resources/{resourceId} {
      allow read: if true; // Public read
      
      allow create: if isAdmin() && 
                    isValidResource(request.resource.data) &&
                    isValidId(resourceId);
                    
      allow update: if isAdmin() && 
                    isValidResource(request.resource.data) &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'imageUrl', 'category', 'updatedAt']));
                    
      allow delete: if isAdmin();
    }

    // Team Logos Collection
    match /teamLogos/{logoId} {
      allow read: if true; // Public read
      
      allow create: if isAdmin() && 
                    isValidResource(request.resource.data) &&
                    isValidId(logoId);
                    
      allow update: if isAdmin() && 
                    isValidResource(request.resource.data) &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'imageUrl', 'category', 'updatedAt']));
                    
      allow delete: if isAdmin();
    }

    // Video Classes Collection
    match /videoClasses/{classId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
